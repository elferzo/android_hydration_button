<?xml version="1.0" encoding="utf-8"?>
<!--
    1x1 виджет: плоский FrameLayout + LinearLayout внутри.
    RemoteViews находит tv_label и tv_count напрямую.
    Минимальный padding чтобы вписаться в клетку 1x1.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/btn_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#757575"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/transparent">

        <!-- "H2O" — основная надпись, крупная -->
        <TextView
            android:id="@+id/tv_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="H2O"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Счётчик стаканов — подстрочный, мелкий -->
        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="1dp" />

    </LinearLayout>

</FrameLayout>
